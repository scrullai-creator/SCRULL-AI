# Scrull AI: chaves do projeto
# Copie este arquivo para ".env.local" e preencha. NUNCA publique o .env.local nem mande no chat.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # chave secreta: só no servidor

# Meta / Instagram (developers.facebook.com > seu app > Configurações > Básico)
META_APP_ID=
META_APP_SECRET=                     # chave secreta: só no servidor
# Identificação da configuração do login unificado (Casos de uso > Instagram >
# "API setup with Unified login"). Não é segredo.
INSTAGRAM_CONFIG_ID=

# IA de texto (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=                   # chave secreta: só no servidor

# IA de imagens (platform.openai.com > API keys)
OPENAI_API_KEY=                      # chave secreta: só no servidor
# OPENAI_IMAGE_MODEL=gpt-image-1.5   # opcional
# OPENAI_IMAGE_QUALITY=medium        # opcional: low | medium | high

# Edição de vídeo com IA (app.submagic.co > Settings > API). Opcional: sem ela, os vídeos
# viram reels sem edição (legenda escrita pela IA, mas sem legendas animadas no vídeo).
SUBMAGIC_API_KEY=                    # chave secreta: só no servidor
# SUBMAGIC_TEMPLATE=Sara             # opcional: estilo das legendas
# SUBMAGIC_LANGUAGE=pt               # opcional

# Gerada por você: 32 caracteres aleatórios, para cifrar os tokens do Instagram
ENCRYPTION_KEY=

# Gerada por você: protege o endereço que dispara a fila de publicação
CRON_SECRET=

# Endereço do app (ex.: https://scrull.vercel.app)
APP_URL=

# Mercado Pago (mercadopago.com.br/developers > Suas integrações > Credenciais de produção)
MP_ACCESS_TOKEN=                     # chave secreta: só no servidor
