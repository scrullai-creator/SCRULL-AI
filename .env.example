# Scrull AI: chaves do projeto
# Copie este arquivo para ".env.local" e preencha. NUNCA publique o .env.local nem mande no chat.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # chave secreta: só no servidor

# Meta / Instagram (developers.facebook.com > seu app > Configurações > Básico)
META_APP_ID=
META_APP_SECRET=                     # chave secreta: só no servidor
# Identificação da configuração do login unificado (Casos de uso > Instagram >
# "API setup with Unified login"). Não é segredo.
INSTAGRAM_CONFIG_ID=

# IA (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=                   # chave secreta: só no servidor

# Gerada por você: 32 caracteres aleatórios, para cifrar os tokens do Instagram
ENCRYPTION_KEY=

# Gerada por você: protege o endereço que dispara a fila de publicação
CRON_SECRET=

# Endereço do app (ex.: https://scrull.vercel.app)
APP_URL=
